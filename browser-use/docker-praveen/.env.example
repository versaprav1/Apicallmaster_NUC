# Copy this file to .env and fill in your keys
# This .env is read by docker-praveen/docker-praveen.ps1

# OpenAI
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=

# Google
GOOGLE_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Groq
GROQ_API_KEY=

# xAI Grok
GROK_API_KEY=

# Novita
NOVITA_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Browserbase (optional)
BROWSERBASE_API_KEY=

# PostHog telemetry (optional)
POSTHOG_API_KEY=
POSTHOG_HOST=
